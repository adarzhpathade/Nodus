# Copy to .env.local and fill in. Never commit real values.
# `neon deploy` / `neon env pull` fill the Neon values (Postgres, Auth, Storage) automatically.

# Postgres: pooled URL for the app, direct (unpooled) URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (NEON_AUTH_COOKIE_SECRET is yours to generate: openssl rand -base64 32)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible, bucket "nodus-uploads")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# AI (Groq is an optional fallback)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
HEALTHCHECK_SECRET=

# Parallel development: comma list or "all"; empty = everything real.
# Features: auth,curriculum,resources,notes,graph,ai,assignments,dashboard,notifications
MOCK_FEATURES=all
