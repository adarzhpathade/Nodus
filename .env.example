# Copy to .env.local and fill in. Never commit real values.

# Database (Neon Postgres + pgvector)
DATABASE_URL=

# Auth (Neon Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=          # at least 32 characters

# AI
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=                     # optional fallback

# Storage (faculty uploads)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Parallel development: comma list or "all" (empty = everything real)
# Features: auth,curriculum,resources,notes,graph,ai,assignments,dashboard,notifications
MOCK_FEATURES=all
